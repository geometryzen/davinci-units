{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "node",
        "declaration": true,
        "declarationDir": "./dist",
        "emitDeclarationOnly": true,
        "sourceMap": false,
        "outDir": "./dist",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "noImplicitAny": true,
        "strictNullChecks": false,
        "noImplicitThis": true,
        "noUnusedLocals": true,
        "noUnusedParameters": false,
        "noImplicitReturns": true,
        "skipLibCheck": true,
        "removeComments": false,
        "resolveJsonModule": true,
        "types": [
            "jest"
        ]
    },
    "include": [
        "./src/**/*.ts",
        "./rollup.config.mts",
        "./rollup-plugin-dts.d.ts"
, "src/math/gauss.spec.mts"    ],
    "exclude": [
        "node_modules"
    ],
    "lib": [
        "es2015",
        "dom"
    ]
}