{
    "name": "davinci-units",
    "version": "1.6.11",
    "description": "Geometric Numbers with Units for Mathematical Physics using Geometric Algebra",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index-esm.min.js",
            "require": "./dist/index-cjs.js",
            "system": "./dist/index-system.min.js",
            "default": "./dist/index-esm.min.js"
        }
    },
    "browser": "./dist/index-umd.js",
    "main": "./dist/index-cjs.js",
    "module": "./dist/index-esm.min.js",
    "type": "module",
    "types": "./dist/index.d.ts",
    "files": [
        "dist/index-cjs.js",
        "dist/index-cjs.js.map",
        "dist/index-esm.js",
        "dist/index-esm.js.map",
        "dist/index-esm.min.js",
        "dist/index-esm.min.js.map",
        "dist/index.d.ts",
        "dist/index-system.js",
        "dist/index-system.js.map",
        "dist/index-system.min.js",
        "dist/index-system.min.js.map",
        "dist/index-umd.js",
        "dist/index-umd.js.map"
    ],
    "author": {
        "name": "David Geo Holmes",
        "email": "david.geo.holmes@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "git://github.com/geometryzen/davinci-units.git"
    },
    "engines": {
        "node": ">=4"
    },
    "bugs": {
        "url": "https://github.com/geometryzen/davinci-units/issues"
    },
    "license": "MIT",
    "licenses": [
        {
            "type": "MIT",
            "url": "https://github.com/geometryzen/davinci-units/blob/master/LICENSE"
        }
    ],
    "keywords": [
        "STEMCstudio",
        "Geometric",
        "Algebra",
        "Physics",
        "Mathematics"
    ],
    "scripts": {
        "build": "npm run clean && rollup --config rollup.config.mts --configPlugin @rollup/plugin-typescript --configImportAttributesKey with",
        "check": "npx package-check",
        "clean": "rm -rf coverage && rm -rf dist && rm -rf docs && rm -rf es2015 && rm -rf system && rm -rf types && rm -rf dist",
        "coverage": "npm run test -- --coverage",
        "dev": "rollup --config rollup.config.mts --configPlugin @rollup/plugin-typescript --configImportAttributesKey with -w",
        "docs": "npm run docs:typedoc && open-cli docs/index.html",
        "docs:typedoc": "rm -rf docs && typedoc --options typedoc.json",
        "format:check": "prettier --check '**/*.{js,ts,tsx,css,yml,json}'",
        "format:write": "prettier --write '**/*.{js,ts,tsx,css,yml,json}'",
        "lint": "eslint .",
        "pages": "npm run docs:typedoc && gh-pages -d docs",
        "release": "release-it",
        "test": "jest"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.2",
        "@rollup/plugin-typescript": "^12.3.1",
        "@skypack/package-check": "^0.2.2",
        "@types/chai": "^4.3.0",
        "@types/jest": "^30.0.0",
        "@types/rollup-plugin-peer-deps-external": "^2.2.6",
        "@typescript-eslint/eslint-plugin": "^8.72.1",
        "@typescript-eslint/parser": "^8.72.1",
        "chai": "^4.3.0",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "gh-pages": "6.3.0",
        "globals": "^17.14.0",
        "jest": "^30.5.2",
        "open-cli": "^9.0.0",
        "prettier": "^3.9.10",
        "release-it": "^21.1.2",
        "rollup": "^4.68.0",
        "rollup-plugin-dts": "^6.5.1",
        "rollup-plugin-peer-deps-external": "^2.2.4",
        "ts-jest": "^29.4.15",
        "ts-jest-resolver": "^2.0.1",
        "ts-node": "^10.9.2",
        "typedoc": "^0.28.20",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.72.1"
    },
    "allowScripts": {
        "@parcel/watcher@2.6.0": true,
        "unrs-resolver@1.12.2": true
    }
}
